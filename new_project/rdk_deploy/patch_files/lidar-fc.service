[Unit]
Description=Lidar to FC Auto Flight Data Link
After=network-online.target time-sync.target dev-ttyFC.device
Wants=network-online.target time-sync.target
Requires=dev-ttyFC.device

[Service]
Type=simple
User=sunrise
Group=sunrise
SupplementaryGroups=dialout
WorkingDirectory=/home/sunrise/project
ExecStartPre=/bin/udevadm settle --timeout=15
ExecStart=/bin/bash /home/sunrise/project/start_all.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
Environment="PYTHONUNBUFFERED=1"
Environment="HOME=/home/sunrise"
Environment="ROS_DOMAIN_ID=0"

[Install]
WantedBy=multi-user.target
